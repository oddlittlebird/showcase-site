{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "showcase:frontmatter:1.0",
  "title": "Showcase site front matter v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "description", "last_reviewed"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}

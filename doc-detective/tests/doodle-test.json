{
  "specId": "doodle-test",
  "description": "Fetches today's Google doodle and saves it as a GIF and PNG.",
  "tests": [
    {
      "testId": "fetch-doodle",
      "description": "Navigate to Google, screenshot the doodle element as a PNG, and download the animated GIF.",
      "steps": [
        {
          "goTo": "https://www.google.com"
        },
        {
          "screenshot": {
            "path": "website/static/doc-detective/doodle.png",
            "crop": "#hplogo",
            "overwrite": "true"
          }
        },
        {
          "runShell": "bash doc-detective/scripts/download-doodle.sh"
        }
      ]
    }
  ]
}

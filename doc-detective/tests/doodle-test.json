{
  "id": "doodle-test",
  "description": "Fetches today's Google doodle and saves it as a GIF and PNG.",
  "tests": [
    {
      "id": "fetch-doodle",
      "description": "Navigate to Google, screenshot the doodle element as a PNG, and download the animated GIF.",
      "steps": [
        {
          "action": "goTo",
          "url": "https://www.google.com"
        },
        {
          "action": "find",
          "selector": "#hplogo",
          "screenshot": "website/static/doc-detective/doodle.png"
        },
        {
          "action": "runShell",
          "command": "bash doc-detective/scripts/download-doodle.sh"
        }
      ]
    }
  ]
}

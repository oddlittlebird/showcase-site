{
  "specId": "sample-pipeline-test",
  "description": "Verifies that the documentation pipeline overview page loads and contains expected content.",
  "tests": [
    {
      "testId": "pipeline-page-loads",
      "description": "The pipeline overview page exists and renders the expected heading.",
      "steps": [
        {
          "goTo": "http://localhost:3000/showcase-site/docs/pipeline"
        },
        {
          "find": {
            "selector": "h1",
            "elementText": "Documentation Pipeline Portfolio"
          }
        },
        {
          "find": {
            "selector": "body",
            "elementText": "/Vale/"
          }
        },
        {
          "find": {
            "selector": "body",
            "elementText": "/codespell/"
          }
        },
        {
          "find": {
            "selector": "body",
            "elementText": "/Lychee/"
          }
        },
        {
          "find": {
            "selector": "body",
            "elementText": "/Doc Detective/"
          }
        }
      ]
    }
  ]
}
